# /etc/mc-waker/survival.env: one file per server. See README.md for every setting.
WAKER_ID=survival
WAKER_UNIT=survival.service
WAKER_JAVA_PORT=25565
WAKER_BEDROCK_PORT=19132
# open = any well-formed join wakes it (scanner guard on); whitelist = only names in the whitelist credential
WAKER_MODE=whitelist
#WAKER_NAME=Survival
#WAKER_ASLEEP_TEXT=asleep, players seen before: join to wake; new players: use /wake in Discord
#WAKER_DENY_TEXT=This server is asleep. Wake it with /wake in the server's Discord.
#WAKER_COOLDOWN_S=600
#WAKER_IP_LIMIT=5
