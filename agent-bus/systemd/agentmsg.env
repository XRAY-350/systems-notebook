# /etc/agentmsg.env, read by every unit below
AGENTMSG_STORE=/var/lib/agent-bus
AGENTMSG_AGENTS=builder,ops,infra,laptop-builder,laptop-ops,orchestrator
AGENTMSG_WATCHED=builder,ops,infra
AGENTMSG_TZ=America/New_York
AGENTMSG_QUIET=03-07
AGENTMSG_OWNER_SIGNERS=/etc/agentmsg/owner_allowed_signers
# AGENTMSG_MIRROR_CMD=/usr/local/bin/post-to-chat
WATCHD_STATE_CMD=/usr/local/lib/agent-bus/examples/tmux-state.sh {agent}
WATCHD_WAKE_CMD=/usr/local/lib/agent-bus/examples/tmux-wake.sh {agent} {text}
WATCHD_ALERT_TO=laptop-ops
